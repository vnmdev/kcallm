# Local development. Copy to .env and run uv with --env-file .env.
KCALLM_DATA_DIR=.data
KCALLM_PRIVATE_DIR=.private
KCALLM_STARTER_FILE=.private/starter-drafts.json
KCALLM_LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# Optional: SSH alias shown in ChatGPT sign-in instructions when the app runs remotely.
# KCALLM_SSH_HOST=your-server
# Optional: only if your llama.cpp server requires authentication.
# KCALLM_LLAMA_API_KEY=
KCALLM_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
KCALLM_AUTH_BIND=127.0.0.1
KCALLM_AUTH_PORT=18455
